@blog_backend_HostAddress = http://localhost:5256

GET {{blog_backend_HostAddress}}/api/users/health
Accept: application/json

###

POST {{blog_backend_HostAddress}}/api/users/register
Content-Type: application/json

{
  "displayName": "Johnson",
  "email": "johnson@example.com",
  "password": "a123456A!"
}

###

POST {{blog_backend_HostAddress}}/api/users/login
Content-Type: application/json

{
  "email": "johnson@example.com",
  "password": "a123456A!"
}

###

@access_token = paste_login_access_token_here

GET {{blog_backend_HostAddress}}/api/users/me
Authorization: Bearer {{access_token}}
Accept: application/json

###

POST {{blog_backend_HostAddress}}/api/blogs
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "title": "My first blog post",
  "slug": "my-first-blog-post",
  "content": "This is my first blog post."
}

###

@blog_id = paste_created_blog_id_here

POST {{blog_backend_HostAddress}}/api/blogs/{{blog_id}}/comments
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "content": "This is my first comment."
}

###

DELETE {{blog_backend_HostAddress}}/api/blogs/{{blog_id}}
Authorization: Bearer {{access_token}}

###

GET {{blog_backend_HostAddress}}/api/blogs/health
Accept: application/json

###
