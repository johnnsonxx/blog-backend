@blog_backend_HostAddress = http://localhost:5256

GET {{blog_backend_HostAddress}}/api/users/health
Accept: application/json

###

POST {{blog_backend_HostAddress}}/api/users/register
Content-Type: application/json

{
  "displayName": "Johnson",
  "email": "johnson@example.com",
  "password": "a123456A!"
}

###

POST {{blog_backend_HostAddress}}/api/users/login
Content-Type: application/json

{
  "email": "johnson@example.com",
  "password": "change-me-123"
}

###

@access_token = paste_login_access_token_here

GET {{blog_backend_HostAddress}}/api/users/me
Authorization: Bearer {{access_token}}
Accept: application/json

###

GET {{blog_backend_HostAddress}}/api/blogs/health
Accept: application/json

###
